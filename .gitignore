# ── Entorno virtual ──────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo

# ── Variables de entorno (secretos) ───────────────────────────
.env
.env.local
.env.*.local

# ── Datos pesados (no subir al repo) ─────────────────────────
public/training_data/**/*.mp4
public/training_data/**/*.avi
public/videos/raw/

# ── Modelos entrenados (binarios grandes) ────────────────────
# Los .onnx / .pt que sí se distribuyen viven en python_scripts/checkpoints
# y public/ (modelo de inferencia del navegador).
*.keras
*.h5
*.tflite
# No ignorar los .onnx que sí se commitean (public/sign_model.onnx,
# python_scripts/checkpoints/sign_model.onnx).

# ── Archivos temporales / logs ────────────────────────────────
*.log
*.tmp
.DS_Store
Thumbs.db
test1.mp4

# ── Build artifacts ───────────────────────────────────────────
node_modules/
dist/
.vite/

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Vite preview / cache ──────────────────────────────────────
*.local

# ── Archivo: contenido archivado (legacy/hardware) ───────────
# _archive/ se mantiene en el repo (ya commiteado) pero no se toca
# durante el desarrollo activo. Sin regla de ignore para que git lo
# rastree, pero los binarios pesados que pudiera contener sí se ignoran:
_archive/**/*.pyc
_archive/**/__pycache__/
_archive/**/.gradle/
_archive/**/build/
_archive/**/.dart_tool/
_archive/**/.pio/
