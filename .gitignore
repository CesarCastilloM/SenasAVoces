# ── Entorno virtual ──────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo

# ── Variables de entorno (secretos) ───────────────────────────
.env
.env.local
.env.*.local
# Archivo "env" sin punto en la raíz (contiene las claves de Supabase);
# la regla env/ de arriba solo cubre carpetas, no este archivo.
env

# ── Datos pesados (no subir al repo) ─────────────────────────
public/training_data/**/*.mp4
public/training_data/**/*.avi
public/videos/raw/

# ── Modelos entrenados (binarios grandes) ────────────────────
# Los .onnx / .pt que sí se distribuyen viven en python_scripts/checkpoints
# y public/ (modelo de inferencia del navegador).
*.keras
*.h5
*.tflite
# No ignorar los .onnx que sí se commitean (public/sign_model.onnx,
# python_scripts/checkpoints/sign_model.onnx).

# ── Archivos temporales / logs ────────────────────────────────
*.log
*.tmp
.DS_Store
Thumbs.db
test1.mp4

# ── Build artifacts ───────────────────────────────────────────
node_modules/
dist/
.vite/

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Vite preview / cache ──────────────────────────────────────
*.local

# ── Archivo: contenido archivado (legacy/hardware) ───────────
# Código legacy (guante ESP32, backend Flask, app Flutter). Se conserva
# en disco como referencia pero git ya no lo rastrea.
_archive/
